{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "control-center-exclusive-zone": false,
  "layer-shell": true,
  "cssPriority": "application",
  "control-center-margin-top": -46,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 64,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 680,
  "control-center-height": 520,
  "notification-window-width": 380,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,

  "widgets": [
    "custom/profile",
    "menubar",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "title",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notifications Stream",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "custom/profile": {
      "exec": "/home/sh1ragami/.config/swaync/scripts/profile.sh",
      "return-type": "json",
      "interval": 30,
      "escape": false
    },
    "menubar": {
      "menu#dashboard": {
        "label": "󰋜 Dashboard",
        "position": "left",
        "actions": [
          {
            "label": "󰋜 Clear Notifications",
            "type": "button",
            "command": "swaync-client -C"
          }
        ]
      },
      "menu#media": {
        "label": "󰎈 Media Player",
        "position": "left",
        "actions": [
          {
            "label": "󰓇 Launch Spotify Player",
            "type": "button",
            "command": "spotify"
          },
          {
            "label": "󰐊 Play / Pause",
            "type": "button",
            "command": "playerctl play-pause"
          },
          {
            "label": "󰒮 Next Track",
            "type": "button",
            "command": "playerctl next"
          },
          {
            "label": "󰒫 Previous Track",
            "type": "button",
            "command": "playerctl previous"
          }
        ]
      },
      "menu#performance": {
        "label": "󰓅 Performance",
        "position": "left",
        "actions": [
          {
            "label": "󰨇 Launch Btop System Monitor",
            "type": "button",
            "command": "kitty -e btop"
          },
          {
            "label": "󰍛 Launch Pavucontrol Audio",
            "type": "button",
            "command": "pavucontrol"
          },
          {
            "label": "󰂯 Launch Blueman Manager",
            "type": "button",
            "command": "blueman-manager"
          }
        ]
      },
      "menu#themes": {
        "label": "󰔎 Themes",
        "position": "left",
        "actions": [
          {
            "label": "󰖔 Sunset Theme",
            "type": "button",
            "command": "/home/sh1ragami/.config/hypr/scripts/theme_selector_direct.sh sunset"
          },
          {
            "label": "󰄛 Catppuccin Theme",
            "type": "button",
            "command": "/home/sh1ragami/.config/hypr/scripts/theme_selector_direct.sh catppuccin"
          },
          {
            "label": "󰄛 Tokyo Night Theme",
            "type": "button",
            "command": "/home/sh1ragami/.config/hypr/scripts/theme_selector_direct.sh tokyonight"
          },
          {
            "label": "󰂺 Study Mode Theme",
            "type": "button",
            "command": "/home/sh1ragami/.config/hypr/scripts/theme_selector_direct.sh study"
          }
        ]
      }
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰤨  Wi-Fi",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update_command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
        },
        {
          "label": "󰂯  Bluetooth",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off'",
          "update_command": "sh -c '[[ $(bluetoothctl show | grep \"PowerState\") == *\"on\"* ]] && echo true || echo false'"
        },
        {
          "label": "󰍶  Do Not Disturb",
          "type": "toggle",
          "active": false,
          "command": "swaync-client -d",
          "update_command": "swaync-client -D"
        },
        {
          "label": "󰌐  Key Sounds",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && wayvibes || pkill wayvibes'",
          "update_command": "sh -c 'pgrep wayvibes >/dev/null && echo true || echo false'"
        }
      ]
    },
    "mpris": {
      "image-size": 85,
      "image-radius": 14
    },
    "volume": {
      "label": "󰕾 Volume"
    },
    "backlight": {
      "label": "󰃠 Brightness",
      "device": "intel_backlight"
    }
  }
}