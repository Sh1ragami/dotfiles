{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "height": 30,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["custom/clock_dnd"],
    "modules-right": [
        "group/hardware"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },

    "custom/clock_dnd": {
        "format": "{}",
        "return-type": "json",
        "interval": 1,
        "exec": "~/.config/waybar/scripts/clock_dnd.sh",
        "on-click": "~/.config/waybar/scripts/toggle_control_center.sh",
        "on-click-right": "gnome-calendar"
    },

    "group/hardware": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "bluetooth", "network", "memory", "battery"]
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "overskride || blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "  Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pwvucontrol || pavucontrol"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀 wired",
        "format-disconnected": "⚠ offline",
        "tooltip-format": "{ifname} via {gwaddr}\n{essid}",
        "on-click": "XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi"
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 10,
        "tooltip-format": "Memory: {used:0.1f}GiB / {total:0.1f}GiB",
        "on-click": "~/.config/hypr/scripts/toggle_btop.sh"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "",
            "none": "",
            "dnd-notification": "",
            "dnd-none": "",
            "inhibited-notification": "",
            "inhibited-none": "",
            "dnd-inhibited-notification": "",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}
