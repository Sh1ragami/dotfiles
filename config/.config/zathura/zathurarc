set guioptions ""
set selection-clipboard clipboard
set adjust-open "width"
set page-padding 0

set default-bg "#1a102f"
set default-fg "#f8f8f2"
set statusBar-bg "#1a102f"
set statusBar-fg "#f8f8f2"
set inputbar-bg "#1a102f"
set inputbar-fg "#f8f8f2"
set notification-bg "#1a102f"
set notification-fg "#f8f8f2"

set recolor "true"
set recolor-lightcolor "#1a102f"
set recolor-darkcolor "#f8f8f2"
set recolor-reverse-video "true"
set recolor-keephue "true"
set render-loading "false"
