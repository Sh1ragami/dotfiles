set guioptions ""
set selection-clipboard clipboard
set adjust-open "width"
set page-padding 0

set default-bg "#1a1b26"
set default-fg "#a9b1d6"
set statusBar-bg "#1a1b26"
set statusBar-fg "#a9b1d6"
set inputbar-bg "#1a1b26"
set inputbar-fg "#a9b1d6"
set notification-bg "#1a1b26"
set notification-fg "#a9b1d6"

set recolor "true"
set recolor-lightcolor "#1a1b26"
set recolor-darkcolor "#a9b1d6"
set recolor-reverse-video "true"
set recolor-keephue "true"
set render-loading "false"
