[Unit]
Description=Google Drive periodic backup for Documents, Pictures, Music, and Videos
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.config/rclone/sync_gdrive.sh
Nice=19
IOSchedulingClass=2
IOSchedulingPriority=7
