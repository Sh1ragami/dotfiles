#!/usr/bin/env python3
import sys
import time
import os
import signal
import subprocess
import termios
import tty
import select
from datetime import timedelta

# ANSI Escape Sequences
CLEAR_SCREEN = "\033[2J"
CURSOR_HOME = "\033[H"
HIDE_CURSOR = "\033[?25l"
SHOW_CURSOR = "\033[?25h"
RESET = "\033[0m"

# Minimal & Sophisticated Color Palette
C_STEAM_1 = "\033[38;5;238m"  # Fading top steam (subtle dark gray)
C_STEAM_2 = "\033[38;5;242m"  # Mid-upper steam
C_STEAM_3 = "\033[38;5;246m"  # Mid-lower steam
C_STEAM_4 = "\033[38;5;251m"  # Fresh steam near cup
C_CUP     = "\033[38;5;253m"  # Modern clean off-white
C_SAUCER  = "\033[38;5;241m"  # Muted charcoal saucer
C_TEXT    = "\033[38;5;242m"  # Subtle status gray
C_MUTED   = "\033[38;5;238m"  # Low contrast instruction
C_TIME    = "\033[38;5;250m"  # Crisp time display

STEAM_PATTERNS = [
    "         .  ~  .       ",
    "        (   )   )      ",
    "         ) (   (       ",
    "        (   )   )      ",
    "         ~  .  ~       ",
    "        )   (   (      ",
    "       (     )   )     ",
    "        )   (   (      ",
]

CUP_ART = [
    rf"{C_CUP}       .---------.\{RESET}",
    rf"{C_CUP}      /           \ \{RESET}",
    rf"{C_CUP}     |             | |{RESET}",
    rf"{C_CUP}      \           / /{RESET}",
    rf"{C_CUP}       `---------'/{RESET}",
    rf"{C_SAUCER}      -------------{RESET}"
]

def render(step, start_time):
    elapsed = int(time.time() - start_time)
    hours, remainder = divmod(elapsed, 3600)
    minutes, seconds = divmod(remainder, 60)
    time_str = f"{hours:02d}:{minutes:02d}:{seconds:02d}"

    buf = [CURSOR_HOME, "\n"]

    n = len(STEAM_PATTERNS)
    # Render 4 lines of rising steam
    buf.append(f"{C_STEAM_1}{STEAM_PATTERNS[(n - step % n) % n]}{RESET}\n")
    buf.append(f"{C_STEAM_2}{STEAM_PATTERNS[(n - (step + 1) % n) % n]}{RESET}\n")
    buf.append(f"{C_STEAM_3}{STEAM_PATTERNS[(n - (step + 2) % n) % n]}{RESET}\n")
    buf.append(f"{C_STEAM_4}{STEAM_PATTERNS[(n - (step + 3) % n) % n]}{RESET}\n")

    # Render Cup
    for line in CUP_ART:
        buf.append(f"{line}\n")

    # Status
    buf.append("\n")
    buf.append(f"   {C_TEXT}caffeinated · {C_TIME}{time_str}{RESET}\n")
    buf.append(f"   {C_MUTED}press q or ctrl+c to exit{RESET}\n")

    sys.stdout.write("".join(buf))
    sys.stdout.flush()

def main():
    inhibitor_proc = None

    # Start inhibitor in background if available
    script_dir = os.path.dirname(os.path.abspath(__file__))
    local_inhibitor = os.path.join(script_dir, "wayland-idle-inhibitor.py")
    system_inhibitor = "/usr/bin/wayland-idle-inhibitor.py"

    inhibitor_cmd = None
    if os.path.exists(local_inhibitor):
        inhibitor_cmd = [sys.executable, local_inhibitor]
    elif os.path.exists(system_inhibitor):
        inhibitor_cmd = [sys.executable, system_inhibitor]

    if inhibitor_cmd:
        try:
            inhibitor_proc = subprocess.Popen(
                inhibitor_cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
        except Exception:
            pass

    # Terminal input settings for non-blocking single key press ('q')
    old_settings = None
    if sys.stdin.isatty():
        try:
            old_settings = termios.tcgetattr(sys.stdin)
            tty.setcbreak(sys.stdin.fileno())
        except Exception:
            old_settings = None

    def cleanup(signum=None, frame=None):
        if inhibitor_proc:
            try:
                inhibitor_proc.terminate()
                inhibitor_proc.wait(timeout=1)
            except Exception:
                pass
        
        if old_settings and sys.stdin.isatty():
            try:
                termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)
            except Exception:
                pass

        sys.stdout.write(SHOW_CURSOR + "\n\n   caffeinate stopped.\n\n")
        sys.stdout.flush()
        sys.exit(0)

    signal.signal(signal.SIGINT, cleanup)
    signal.signal(signal.SIGTERM, cleanup)

    sys.stdout.write(CLEAR_SCREEN + HIDE_CURSOR)
    sys.stdout.flush()

    start_time = time.time()
    step = 0

    try:
        while True:
            render(step, start_time)
            step += 1
            
            if sys.stdin.isatty():
                rlist, _, _ = select.select([sys.stdin], [], [], 0.25)
                if rlist:
                    ch = sys.stdin.read(1)
                    if ch in ('q', 'Q', '\x03'):  # 'q' or Ctrl+C
                        break
            else:
                time.sleep(0.25)
    except KeyboardInterrupt:
        pass
    finally:
        cleanup()

if __name__ == "__main__":
    main()
