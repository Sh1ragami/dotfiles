{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "bottom",
  "control-center-positionX": "center",
  "control-center-positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "control-center-exclusive-zone": false,
  "layer-shell": true,
  "cssPriority": "application",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 64,
  "notification-body-image-height": 160,
  "notification-body-image-width": 280,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 420,
  "control-center-height": 620,
  "notification-window-width": 300,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,

  "widgets": [
    "custom/profile",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "title",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notifications Stream",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "custom/profile": {
      "exec": "/home/sh1ragami/.config/swaync/scripts/profile.sh",
      "return-type": "json",
      "interval": 30,
      "escape": false
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰤨  Wi-Fi",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update_command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
        },
        {
          "label": "󰂯  Bluetooth",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off'",
          "update_command": "sh -c '[[ $(bluetoothctl show | grep \"PowerState\") == *\"on\"* ]] && echo true || echo false'"
        },
        {
          "label": "󰍶  DND",
          "type": "toggle",
          "active": false,
          "command": "sh -c 'swaync-client -d -sw && pkill -SIGUSR2 waybar'",
          "update_command": "sh -c '[[ $(swaync-client -D) == \"true\" ]] && echo true || echo false'"
        },
        {
          "label": "󰕾  Mixer",
          "type": "normal",
          "command": "pwvucontrol"
        },
        {
          "label": "󰌌  Key Sound",
          "type": "toggle",
          "active": false,
          "command": "/home/sh1ragami/.config/waybar/scripts/wayvibes_toggle.sh",
          "update_command": "sh -c 'pgrep -x wayvibes >/dev/null && echo true || echo false'"
        },
        {
          "label": "󱡁  Effects",
          "type": "normal",
          "command": "python3 /home/sh1ragami/.config/swaync/scripts/docked_sliders_toggle.py"
        },
        {
          "label": "  Power",
          "type": "normal",
          "command": "wlogout"
        }
      ]
    },
    "mpris": {
      "image-size": 70,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾 Volume"
    },
    "backlight": {
      "label": "󰃠 Brightness",
      "device": "intel_backlight"
    }
  }
}